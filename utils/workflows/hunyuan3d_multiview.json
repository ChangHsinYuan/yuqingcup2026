{
  "1": {"class_type": "LoadImage", "inputs": {"image": {{front_image}}}},
  "2": {"class_type": "LoadImage", "inputs": {"image": {{left_image}}}},
  "3": {"class_type": "LoadImage", "inputs": {"image": {{back_image}}}},
  "4": {"class_type": "CLIPVisionLoader", "inputs": {"clip_name": "hunyuan3d_dinov2_giant.safetensors"}},
  "5": {"class_type": "CLIPVisionEncode", "inputs": {"clip_vision": ["4", 0], "image": ["1", 0], "crop": "center"}},
  "6": {"class_type": "CLIPVisionEncode", "inputs": {"clip_vision": ["4", 0], "image": ["2", 0], "crop": "center"}},
  "7": {"class_type": "CLIPVisionEncode", "inputs": {"clip_vision": ["4", 0], "image": ["3", 0], "crop": "center"}},
  "8": {"class_type": "Hunyuan3Dv2ConditioningMultiView", "inputs": {"front": ["5", 0], "left": ["6", 0], "back": ["7", 0]}},
  "9": {"class_type": "EmptyLatentHunyuan3Dv2", "inputs": {"resolution": 3072, "batch_size": 1}},
  "10": {"class_type": "UNETLoader", "inputs": {"unet_name": "hunyuan3d-dit-v2-0-turbo.fp16.safetensors", "weight_dtype": "default"}},
  "11": {"class_type": "VAELoader", "inputs": {"vae_name": "hunyuan3d-vae-v2-0.fp16.safetensors"}},
  "12": {"class_type": "KSampler", "inputs": {"model": ["10", 0], "seed": {{seed}}, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["8", 0], "negative": ["8", 1], "latent_image": ["9", 0], "denoise": 1.0}},
  "13": {"class_type": "VAEDecodeHunyuan3D", "inputs": {"samples": ["12", 0], "vae": ["11", 0], "num_chunks": 8000, "octree_resolution": 256}},
  "14": {"class_type": "VoxelToMesh", "inputs": {"voxel": ["13", 0], "algorithm": "surface net", "threshold": 0.6}},
  "15": {"class_type": "SaveGLB", "inputs": {"mesh": ["14", 0], "filename_prefix": {{filename_prefix}}}}
}
